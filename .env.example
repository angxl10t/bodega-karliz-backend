# ==============================================================================
# CajaYa Cloud POS — Variables de Entorno de Producción (Render / Supabase)
# ==============================================================================
# IMPORTANTE: No subir un archivo .env real a Git. Configurar estas variables
# directamente en el panel "Environment" del servicio en Render.
# Para desarrollo local opcional, copia este archivo como ".env" (ignorado por Git).

# Perfil de ejecución ("prod" en Render; la app también detecta RENDER=true / RENDER_SERVICE_ID)
SPRING_PROFILES_ACTIVE=prod
RENDER=true

# Base de datos PostgreSQL / Supabase (Transaction Pooler recomendado)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
DB_USERNAME=postgres.<TU_PROYECTO_SUPABASE>
DB_PASSWORD=<REEMPLAZAR_PASSWORD_SUPABASE>

# Seguridad JWT (OBLIGATORIO en producción: mínimo 32 caracteres / 256 bits aleatorios)
JWT_SECRET=<REEMPLAZAR_SECRETO_JWT_64_HEX_ALEATORIO>
JWT_EXPIRATION_MS=86400000

# Webhook automático Yape / Plin / MacroDroid (OBLIGATORIO en producción: mínimo 16 caracteres)
# Debe coincidir exactamente con el header X-Yape-Secret (o ?secret=...) configurado en MacroDroid
YAPE_WEBHOOK_SECRET=<REEMPLAZAR_SECRETO_WEBHOOK_YAPE_UNICO>

# Contraseña inicial para el usuario SUPERADMIN ('admin') cuando no existe o sigue con clave por defecto
# En producción se exige longitud >= 8 y se rechaza '123456'
SUPERADMIN_PASSWORD=<REEMPLAZAR_PASSWORD_SUPERADMIN_SEGURO>

# Nunca activar cuentas demo en producción
SEED_DEMO_ACCOUNTS=false

# Proveedores de correo transaccional (OTP de recuperación de contraseña)
# Brevo (prioridad 1 si está configurada) y Resend (fallback)
BREVO_API_KEY=<REEMPLAZAR_API_KEY_BREVO>
BREVO_SENDER_EMAIL=cajayapos@gmail.com
RESEND_API_KEY=<REEMPLAZAR_API_KEY_RESEND_OPCIONAL>
EMAIL_FROM=CajaYa POS <onboarding@resend.dev>

# Consultas DNI / RUC (apis.net.pe)
PERU_API_TOKEN=<REEMPLAZAR_TOKEN_APIS_NET_PE>

# Facturación SUNAT (Deshabilitado intencionalmente para régimen Nuevo RUS / Sin RUC)
# SUNAT_API_TOKEN=
# SUNAT_MODO_PRUEBAS=true
