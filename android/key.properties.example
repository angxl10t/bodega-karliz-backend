# Plantilla de Configuración de Firma para Producción Android
# Copie este archivo como 'key.properties' en esta misma carpeta (android/)
# NUNCA suba su archivo 'key.properties' ni su almacén '*.keystore' / '*.jks' a repositorios públicos git.

storeFile=cajaya-upload-keystore.jks
keyAlias=cajaya_upload_key
storePassword=TU_CONTRASEÑA_DEL_KEYSTORE_AQUI
keyPassword=TU_CONTRASEÑA_DE_CLAVE_AQUI
